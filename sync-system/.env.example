# Copy to .env (next to this file) and fill in. The scraper and the Node
# monitor both read it; real environment variables take precedence.

# --- WordPress (the Y4APK theme, 2.30+) --------------------------------------
WP_URL=https://your-site.example
# From wp-admin: Y4APK ▸ App updates ▸ Settings ▸ Catalog sync. Good for the
# sync routes only.
WP_SYNC_KEY=
# … or instead an administrator's Application Password (Users ▸ Profile):
# WP_USER=admin
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Only when the site has no pretty permalinks (/wp-json/ answers 404):
# WP_API_ROOT=https://your-site.example/?rest_route=

# --- Part 1: scraper/app_scraper.py ------------------------------------------
CATALOG_URL=https://example.com/catalog
# CSS selectors; name/version/link/package are relative to one item. "sel@attr" reads an attribute.
SEL_ITEM=.app-item
SEL_NAME=.app-name
SEL_VERSION=.app-version
SEL_LINK=a
# The Google Play ID, when the page shows one (e.g. @data-package). Empty: the
# theme reads it from the link, or looks the name up on Google Play.
SEL_PACKAGE=
# "Next page" link, e.g. a[rel=next]; leave empty to scrape one page
SEL_NEXT=
MAX_PAGES=10
PAGE_DELAY_SECONDS=2
PAGE_TIMEOUT_SECONDS=20
SCROLLS=0
# Say who you are, so site owners can reach you
SCRAPER_USER_AGENT=AppSyncBot/1.0 (+https://your-site.example/bot)
# rest = through WordPress's REST API (WP_URL + WP_SYNC_KEY); db = straight into
# its database (the MYSQL_* below), for a scraper on the same server.
SYNC_TARGET=rest
# Only when Selenium Manager cannot find Chrome or a matching driver by itself
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
LOG_LEVEL=INFO

# SYNC_TARGET=db only: WordPress's database, as in wp-config.php
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# WP_TABLE_PREFIX=wp_

# --- Part 2: node/version_monitor.js -----------------------------------------
MONITOR_INTERVAL_SECONDS=300
MONITOR_TIMEOUT_SECONDS=120
# 1 = open wp-cron.php after each run, so Write with AI's queue and App updates'
# checks run on time even behind a page cache
MONITOR_WP_CRON=1

# --- Part 3: node/api_rotator.js (command line) ------------------------------
# The theme's AIs take several keys in Write with AI ▸ Settings (commas between);
# these are only for trying the Node rotator from the command line.
API_KEYS=first-key,second-key
# bearer = "Authorization: Bearer <key>", header = API_KEY_NAME header, query = ?API_KEY_NAME=<key>
API_KEY_IN=bearer
API_KEY_NAME=
