# Copy to .env (next to this file) and fill in. Both the Python scraper and
# the Node scripts read it; real environment variables take precedence.

# --- MySQL, shared by all parts -------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app_sync
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=app_sync

# --- Part 1: scraper/app_scraper.py ---------------------------------------
CATALOG_URL=https://example.com/catalog
# CSS selectors; name/version/link are relative to one item. "sel@attr" reads an attribute.
SEL_ITEM=.app-item
SEL_NAME=.app-name
SEL_VERSION=.app-version
SEL_LINK=a
# "Next page" link, e.g. a[rel=next]; leave empty to scrape one page
SEL_NEXT=
MAX_PAGES=10
PAGE_DELAY_SECONDS=2
PAGE_TIMEOUT_SECONDS=20
SCROLLS=0
# Say who you are, so site owners can reach you
SCRAPER_USER_AGENT=AppSyncBot/1.0 (+https://your-site.example/bot)
# Only when Selenium Manager cannot find Chrome or a matching driver by itself
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
LOG_LEVEL=INFO

# --- Part 2: node/version_monitor.js ---------------------------------------
MONITOR_INTERVAL_SECONDS=300
MONITOR_BATCH_SIZE=200
MONITOR_MAX_ATTEMPTS=3
# log = no Firebase, dry-run = Firebase validates but delivers nothing, live = delivered
PUSH_MODE=dry-run
FCM_TOPIC_PREFIX=app_
# Service account key from Firebase console > Project settings > Service accounts,
# relative to this folder. Leave empty to use GOOGLE_APPLICATION_CREDENTIALS instead.
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# --- Part 3: node/api_rotator.js (command line) ----------------------------
API_KEYS=first-key,second-key,third-key
# bearer = "Authorization: Bearer <key>", header = API_KEY_NAME header, query = ?API_KEY_NAME=<key>
API_KEY_IN=bearer
API_KEY_NAME=
